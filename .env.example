# Локальная разработка: скопируйте в .env в корне проекта
# Продакшен: креды задаются в GitHub Secrets (см. docs/GITHUB_SECRETS.md)

# === Фронтенд (rspack) ===
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_VK_ID_APP_ID=YOUR_VK_ID_APP_ID_DEV

# === Бэкенд (server) ===
CORS_ORIGIN=https://127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_assistant
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production

# Опционально: VK ID, Telegram, Google
# Для строгой проверки app_id на сервере:
# - VITE_VK_ID_APP_ID: app_id веб-клиента
# - EXPO_PUBLIC_VK_ID_APP_ID: app_id Android-клиента (mobile/.env, EAS env)
# - VK_ID_APP_IDS: оба app_id через запятую
# Пример:
# VK_ID_APP_IDS=WEB_APP_ID,ANDROID_APP_ID
# VK_ID_APP_ID=WEB_APP_ID
# (VK_ID_APP_ID можно оставить для совместимости, но основной список задавайте в VK_ID_APP_IDS)
# VK_ID_APP_ID=YOUR_VK_WEB_APP_ID
# VK_ID_APP_IDS=YOUR_VK_WEB_APP_ID,YOUR_VK_ANDROID_APP_ID
# TELEGRAM_BOT_TOKEN=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=...
