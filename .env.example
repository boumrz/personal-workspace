# Локальная разработка: скопируйте в .env в корне проекта
# Продакшен: креды задаются в GitHub Secrets (см. docs/GITHUB_SECRETS.md)

# === Фронтенд (rspack) ===
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername
VITE_VK_ID_APP_ID=YOUR_VK_ID_APP_ID_DEV

# === Бэкенд (server) ===
CORS_ORIGIN=https://127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_assistant
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production

# Опционально: VK ID, Telegram, Google
# Для строгой проверки app_id на сервере:
# - VITE_VK_ID_APP_ID: app_id веб-клиента
# - EXPO_PUBLIC_VK_ID_APP_ID: app_id Android-клиента (mobile/.env, EAS env)
# - VK_ID_APP_IDS: оба app_id через запятую
# Пример:
# VK_ID_APP_IDS=WEB_APP_ID,ANDROID_APP_ID
# VK_ID_APP_ID=WEB_APP_ID
# (VK_ID_APP_ID можно оставить для совместимости, но основной список задавайте в VK_ID_APP_IDS)
# VK_ID_APP_ID=YOUR_VK_WEB_APP_ID
# VK_ID_APP_IDS=YOUR_VK_WEB_APP_ID,YOUR_VK_ANDROID_APP_ID
# TELEGRAM_BOT_TOKEN=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=...

# === Voice assistant LLM (server /api/v2/transactions/parse) ===
# Быстрое переключение: перечислите провайдеры по приоритету, fallback на heuristic добавится автоматически.
# Пример: LLM_PROVIDER_CHAIN=gigachat,gemini,heuristic
# Допустимые значения: gigachat | heuristic | openrouter | groq | gemini
# LLM_PROVIDER_CHAIN=gigachat,heuristic
# LLM_PROVIDER=gigachat
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=12000
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# Только для локальной отладки SSL-проблем (не использовать в production)
# GIGACHAT_ALLOW_INSECURE_TLS=false
# Фиче-тоггл: список включённых провайдеров (пусто = все доступны)
# LLM_ENABLED_PROVIDERS=gigachat,gpt4free,gemini,gemini-flash-lite,heuristic
# GPT4FREE_BASE_URL=http://localhost:1337/v1
# GPT4FREE_API_KEY=
# GPT4FREE_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FLASH_LITE_MODEL=gemini-2.0-flash-lite
