# Copy to .env and fill in. Get the key: MyTracker → Application list → your app → Overview.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
EXPO_PUBLIC_MYTRACKER_SDK_KEY=
EXPO_PUBLIC_VK_ID_APP_ID=
EXPO_PUBLIC_VK_ID_REDIRECT_SCHEME=financeassistant
# Optional: force voice parser provider for fast testing (gigachat | gemini | groq | openrouter | heuristic)
EXPO_PUBLIC_SPEECH_PARSE_PROVIDER=
# VK ID Android native SDK requires client secret at build time.
# Do not expose this value in frontend code; keep it only in local .env / CI secrets.
EXPO_PUBLIC_VK_ID_CLIENT_SECRET=
