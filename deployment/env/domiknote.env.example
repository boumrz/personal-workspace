# Copy to deployment/env/domiknote.env on the server.
# Do not commit the real domiknote.env file.

APP_VERSION=latest
DOMIKNOTE_PROXY_NETWORK=domiknote_proxy

# Web build-time public values.
VITE_API_URL=
VITE_TELEGRAM_BOT_USERNAME=
VITE_VK_ID_APP_ID=

# API runtime.
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://domiknote.ru
JWT_SECRET=replace-with-strong-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# PostgreSQL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finance_assistant
DB_USER=finance_assistant
DB_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=finance_assistant
POSTGRES_USER=finance_assistant
POSTGRES_PASSWORD=replace-with-strong-random-password

# Auth providers.
VK_ID_APP_ID=
VK_ID_APP_IDS=
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://domiknote.ru/api/auth/google/callback

# Receipt QR/OCR runtime inside the API image.
RECEIPT_QR_PYTHON=python3
RECEIPT_QR_DECODE_TIMEOUT_MS=20000
RECEIPT_OCR_READ_TIMEOUT_MS=30000

# Voice assistant providers.
LLM_PROVIDER_CHAIN=gigachat,heuristic
LLM_PROVIDER=gigachat
LLM_ENABLED_PROVIDERS=gigachat,heuristic
LLM_TIMEOUT_MS=12000

GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT_MS=30000
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_ALLOW_INSECURE_TLS=false
GIGACHAT_CA_CERT_PEM=
GIGACHAT_CA_CERT_BASE64=
GIGACHAT_CA_CERT_PATH=

# Optional g4f sidecar. Enable compose profile `g4f` when needed.
GPT4FREE_BASE_URL=http://g4f:1337/v1
GPT4FREE_API_KEY=
GPT4FREE_MODEL=gpt-4o-mini
GPT4FREE_TIMEOUT_MS=60000
