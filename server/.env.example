# Шаблон переменных бэкенда
# Локальная dev: используйте .env в КОРНЕ проекта (см. корень/.env.example)
# Продакшен: .env создаётся из GitHub Secrets (docs/GITHUB_SECRETS.md)

PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_assistant
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=https://127.0.0.1

# Voice assistant parser (optional)
# LLM_PROVIDER=heuristic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
