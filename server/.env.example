# Шаблон переменных бэкенда
# Локальная dev: используйте .env в КОРНЕ проекта (см. корень/.env.example)
# Продакшен: .env создаётся из GitHub Secrets (docs/GITHUB_SECRETS.md)

PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_assistant
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=https://127.0.0.1

# Voice assistant parser (optional)
# По умолчанию: gpt4free, heuristic (если не задано в БД для пользователя)
# LLM_PROVIDER_CHAIN=gigachat,heuristic
# Для конкретного пользователя админ может задать провайдер в БД:
#   UPDATE users SET voice_llm_provider = 'gigachat' WHERE id = <user_id>;
#   или цепочку: voice_llm_provider_chain = 'gigachat,heuristic'
# LLM_PROVIDER=gigachat
# LLM_ENABLED_PROVIDERS=gigachat,gpt4free,gemini,gemini-flash-lite,heuristic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=12000
# GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GPT4FREE_BASE_URL=http://localhost:1337/v1
# GPT4FREE_API_KEY=
# GPT4FREE_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FLASH_LITE_MODEL=gemini-2.0-flash-lite
# Только для локальной отладки SSL-проблем (не использовать в production)
# GIGACHAT_ALLOW_INSECURE_TLS=false

# VK ID strict mode (no fallback):
# add all allowed client app_id values (web + android) to VK_ID_APP_IDS
# example: VK_ID_APP_IDS=WEB_APP_ID,ANDROID_APP_ID
VK_ID_APP_ID=
VK_ID_APP_IDS=
